# ========= 基础 =========
# 复制为 .env 并填写。.env 已被 gitignore，绝不提交仓库。
APP_ENV=dev
# 面板登录（首次启动自动创建该用户）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# JWT 签名密钥（生产环境务必改成长随机串）
JWT_SECRET=change-me-to-a-long-random-string
# TradingView 告警 body 内的 secret 字段（与 URL token 双重校验）
WEBHOOK_SECRET=change-me-webhook-secret

# 数据库（默认 SQLite；可切换 Postgres: postgresql+psycopg://user:pwd@host/db）
DATABASE_URL=sqlite:///data/autotrade.db
# 行情/缓存数据目录
DATA_DIR=data

# 是否启用 TradingView 官方出口 IP 白名单（IP 可能变化，默认关闭）
TV_IP_ALLOWLIST_ENABLED=false

# ========= 券商 =========
# Paper 模拟盘（始终建议开启）
PAPER_ENABLED=true

# 富途 OpenAPI（需要本地/容器运行 OpenD 网关）
FUTU_ENABLED=false
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
# SIMULATE=模拟环境, REAL=真实环境（先跑通模拟再切真实！）
FUTU_TRD_ENV=SIMULATE
# 交易解锁密码（真实环境下单必需）
FUTU_UNLOCK_PWD=

# 盈透 IBKR（需要 TWS 或 IB Gateway 运行中；paper 端口 7497 / 实盘 7496）
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# ========= 通知渠道（留空即禁用对应渠道）=========
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
# 企业微信群机器人 webhook 地址
WECOM_WEBHOOK_URL=
# 钉钉群机器人 webhook 地址（含 access_token）
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
